msgid "plugins.generic.scholarOneIntegration.displayName"
msgstr "Integración ScholarOne"

msgid "plugins.generic.scholarOneIntegration.description"
msgstr "Integra OPS y ScholarOne, ingiriendo preprints de OPS en la plataforma ScholarOne"

