msgid "plugins.generic.scholarOneIntegration.settings.accessKey"
msgstr "Clave de acceso"

msgid "plugins.generic.scholarOneIntegration.settings.accessKey.description"
msgstr "La clave de acceso al bucket S3 de Integración de Envíos"

msgid "plugins.generic.scholarOneIntegration.settings.secretKey"
msgstr "Clave secreta"

msgid "plugins.generic.scholarOneIntegration.settings.secretKey.description"
msgstr "La clave secreta para el bucket S3 de Integración de Envíos"


msgid "plugins.generic.scholarOneIntegration.log.errorDepositingFile"
msgstr "Error al depositar el archivo {$filename} en ScholarOne. El mensaje devuelto fue: {$errorMessage}"

